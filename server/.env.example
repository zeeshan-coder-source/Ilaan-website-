# Server Configuration
PORT=5000

# SMTP / Email Configuration
# Example host: smtp.gmail.com, smtp.mailtrap.io, mail.smtp2go.com, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Set SMTP_SECURE to true for port 465 (SSL), false for port 587 (TLS/STARTTLS)
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
# For Gmail, use an "App Password" rather than your main account password
SMTP_PASS=your-gmail-app-password

# Recipient Email
EMAIL_TO=muhammadzeeshan182004@gmail.com
